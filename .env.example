# Copy this file to .env and replace each value with your provider settings.
# Never commit .env or share these credentials.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Twilio Console: Account SID, Auth Token, and your SMS-enabled sender number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP account used to send password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
